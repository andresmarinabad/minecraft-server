#!/usr/bin/env bash
set -euo pipefail
[[ -f .env ]] && set -a && source .env && set +a

: "${RESTIC_REPOSITORY:?Set RESTIC_REPOSITORY in .env}"
: "${RESTIC_PASSWORD_FILE:?Set RESTIC_PASSWORD_FILE in .env}"

if ! restic snapshots >/dev/null 2>&1; then
  echo "Restic repository not initialized. Run: restic init"
  exit 1
fi

running="$(docker inspect -f '{{.State.Running}}' minecraft 2>/dev/null || true)"

if [[ "$running" == "true" ]]; then
  echo "Flushing Minecraft world to disk..."
  docker exec minecraft rcon-cli save-off
  docker exec minecraft rcon-cli save-all flush
fi

cleanup() {
  if [[ "$running" == "true" ]]; then
    docker exec minecraft rcon-cli save-on >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

echo "Creating Restic snapshot..."
restic backup ./data --tag minecraft

echo "Applying retention policy..."
restic forget --keep-last 10 --keep-daily 7 --keep-weekly 4 --prune

echo "Backup complete."
